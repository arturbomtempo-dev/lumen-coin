@startuml

title UC10 - Consultar Extrato

actor Professor as P
actor Aluno as A

participant "Tela do Sistema" as Tela
participant "ControleTransacao" as CT

database "PostgreSQL\nTransacoes" as DBTransacao

group Consulta realizada pelo Professor

P -> Tela : consultarExtrato(professorID)
activate Tela

Tela -> CT : solicitarExtrato(professorID)
activate CT

CT -> DBTransacao : buscarTransacoes(professorID)
activate DBTransacao

DBTransacao --> CT : listaTransacoes
deactivate DBTransacao

CT --> Tela : extratoGerado()

Tela --> P : exibirExtrato()

deactivate CT
deactivate Tela

end

group Consulta realizada pelo Aluno

A -> Tela : consultarExtrato(alunoID)
activate Tela

Tela -> CT : solicitarExtrato(alunoID)
activate CT

CT -> DBTransacao : buscarTransacoes(alunoID)
activate DBTransacao

DBTransacao --> CT : listaTransacoes
deactivate DBTransacao

CT --> Tela : extratoGerado()

Tela --> A : exibirExtrato()

deactivate CT
deactivate Tela

end

@enduml