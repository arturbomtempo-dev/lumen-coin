@startuml

autonumber

title UC12 - Resgatar Vantagem
actor Aluno as A
participant "Tela do Sistema" as Tela
participant "ControleResgate" as CR
participant "ControleVantagem" as CV
database "PostgreSQL\nAlunos" as DBAluno
database "PostgreSQL\nVantagens" as DBVantagem
database "PostgreSQL\nResgates" as DBResgate
queue "Fila de Resgate\nVantagem (RabbitMQ)" as MQ
participant "Worker Vantagem" as WV
participant "Serviço de\nNotificação" as SN

A -> Tela : resgatarVantagem(alunoID, vantagemID)
activate Tela

Tela -> CR : solicitarResgate(alunoID, vantagemID)
activate CR

CR -> DBAluno : buscarAluno(alunoID)
activate DBAluno
DBAluno --> CR : alunoEncontrado(saldo)
deactivate DBAluno

CR -> CV : buscarVantagem(vantagemID)
activate CV
CV -> DBVantagem : buscarVantagem(vantagemID)
activate DBVantagem
DBVantagem --> CV : vantagemEncontrada(custo)
deactivate DBVantagem
CV --> CR : vantagemEncontrada(custo)
deactivate CV

alt Saldo suficiente
    CR -> DBAluno : atualizarSaldo(alunoID, saldo - custo)
    activate DBAluno
    DBAluno --> CR : saldoAtualizado()
    deactivate DBAluno

    CR -> DBResgate : salvarResgate(alunoID, vantagemID,\nstatus=PENDENTE)
    activate DBResgate
    DBResgate --> CR : resgateCriado(codigo)
    deactivate DBResgate

    CR -> MQ : publicarMensagem(alunoID, vantagemID, codigo)
    activate MQ
    MQ --> CR : mensagemEnfileirada()
    deactivate MQ

    CR --> Tela : resgateRealizado(codigo)
    Tela --> A : vantagemResgatada(codigo)

    MQ -> WV : consumirMensagem()
    activate WV
    WV -> DBResgate : atualizarStatus(codigo, status=CONFIRMADO)
    activate DBResgate
    DBResgate --> WV : statusAtualizado()
    deactivate DBResgate

    WV ->> SN : enviarNotificacaoEmail(emailAluno,\nemailEmpresa, codigo)
    deactivate WV
else Saldo insuficiente
    CR --> Tela : erroSaldoInsuficiente()
    Tela --> A : exibirMensagemErro()
else Aluno ou Vantagem não encontrado
    CR --> Tela : erroEntidadeNaoEncontrada()
    Tela --> A : exibirMensagemErro()
end

deactivate CR
deactivate Tela
@enduml
