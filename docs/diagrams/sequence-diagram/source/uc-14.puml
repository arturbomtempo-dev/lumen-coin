@startuml

autonumber

title UC14 - Visualizar Vantagens

actor Aluno as A

participant "Tela do Sistema" as Tela
participant "ControleVantagem" as CV

database "PostgreSQL\nVantagens" as DBVantagem

A -> Tela : visualizarVantagens()
activate Tela

Tela -> CV : listarVantagensDisponiveis()
activate CV

CV -> DBVantagem : buscarVantagens()
activate DBVantagem

DBVantagem --> CV : listaVantagens
deactivate DBVantagem

alt Vantagens encontradas
    CV --> Tela : vantagensEncontradas(listaVantagens)
    Tela --> A : exibirVantagens()
else Nenhuma vantagem cadastrada
    CV --> Tela : listaNaoEncontrada()
    Tela --> A : exibirMensagemVazia()
end

deactivate CV
deactivate Tela

@enduml