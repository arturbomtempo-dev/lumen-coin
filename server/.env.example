# Copy this file to .env and fill in the values
# cp .env.example .env

# Server
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumen-coin-db
DB_USER=lumen
DB_PASSWORD=your_secure_password_here

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security — BCrypt work factor (2^N rounds). Min 10, recommended 12+
BCRYPT_STRENGTH=12

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
