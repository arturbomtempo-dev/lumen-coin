# Copy this file to .env and fill in the values
# cp .env.example .env

# Server
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumen-coin-db
DB_USER=lumen
DB_PASSWORD=changeme

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security — BCrypt work factor (2^N rounds). Min 10, recommended 12+
BCRYPT_STRENGTH=12

# JWT — use a random base64 string of at least 32 bytes
JWT_SECRET=replace-this-with-a-very-long-secret-key-at-least-256-bits
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=lumen_auth
# Set to true in production (requires HTTPS)
JWT_COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# App — public URL used to build links in emails
APP_URL=http://localhost:5173

# Email — SMTP configuration for transactional emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
APP_MAIL_FROM=noreply@lumencoin.com
APP_MAIL_ENABLED=true

# RabbitMQ — Message queue configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
