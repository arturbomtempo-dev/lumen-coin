                                                                        </tr>
                                                                        <tr>
                                                                            <td>
                                                                                <span style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;">M&#201;TODO DE RESGATE</span><br />
                                                                                <span style="font-family:'VT323',monospace;color:#22C55E;font-size:20px;line-height:1.3;">&#9654; QR CODE PRESENCIAL</span>
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>

                                            <p style="font-family:'VT323',monospace;color:#2A2D48;font-size:18px;line-height:1.5;margin:0;text-align:center;">
                                                SEU QR CODE FOI ESCANEADO E O RESGATE<br />
                                                FOI REGISTRADO COM SUCESSO NA PLATAFORMA.<br />
                                                APROVEITE SUA VANTAGEM!
                                            </p>

                                        </td>
                                    </tr>

                                    <tr><td style='height:4px;background-color:#22C55E;border-left:3px solid #080B1A;border-right:3px solid #080B1A;'></td></tr>

                                    <tr>
                                        <td style='background-color:#080B1A;border:3px solid #080B1A;border-top:none;padding:22px 28px;text-align:center;'>
                                            <p style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:8px;margin:0 0 12px 0;letter-spacing:1px;">
                                                &#169; 2025 LUMEN COIN &#8212; TODOS OS DIREITOS RESERVADOS
                                            </p>
                                            <p style="font-family:'VT323',monospace;color:#5A5D7C;font-size:16px;margin:0;line-height:1.5;">
                                                VOCÊ RECEBEU ESTE E-MAIL PORQUE SEU QR CODE FOI<br />
                                                ESCANEADO EM UMA EMPRESA PARCEIRA. NÃO É NECESSÁRIO RESPONDER.
                                            </p>
