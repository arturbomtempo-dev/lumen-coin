        <meta http-equiv='X-UA-Compatible' content='IE=edge' />
        <title>Resgate via QR Code Confirmado! - Lumen Coin</title>
        <link
            href='https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap'
            rel='stylesheet'
            type='text/css'
        />
        <style type='text/css'>
            @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap');
            body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
            table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
            img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
            body { margin: 0 !important; padding: 0 !important; background-color: #f5edda; background-image: repeating-linear-gradient(0deg, transparent, transparent 19px, rgba(8,11,26,0.05) 19px, rgba(8,11,26,0.05) 20px), repeating-linear-gradient(90deg, transparent, transparent 19px, rgba(8,11,26,0.05) 19px, rgba(8,11,26,0.05) 20px); }
            @media only screen and (max-width: 620px) { .email-wrap { width: 100% !important; } }
        </style>
    </head>
    <body style='margin:0;padding:0;background-color:#F5EDDA;background-image:repeating-linear-gradient(0deg,transparent,transparent 19px,rgba(8,11,26,0.05) 19px,rgba(8,11,26,0.05) 20px),repeating-linear-gradient(90deg,transparent,transparent 19px,rgba(8,11,26,0.05) 19px,rgba(8,11,26,0.05) 20px);'>

