<html lang='pt-BR' xmlns='http://www.w3.org/1999/xhtml'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <meta http-equiv='X-UA-Compatible' content='IE=edge' />
        <title>Você Recebeu Moedas! — Lumen Coin</title>
        <link
            href='https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap'
            rel='stylesheet'
            type='text/css'
        />
        <style type='text/css'>
            @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
            body,
            table,
            td,
            a {
                -webkit-text-size-adjust: 100%;
                -ms-text-size-adjust: 100%;
            }
            table,
            td {
                mso-table-lspace: 0pt;
                mso-table-rspace: 0pt;
                border-collapse: collapse;
            }
            img {
                border: 0;
                height: auto;
                line-height: 100%;
                outline: none;
                text-decoration: none;
                -ms-interpolation-mode: bicubic;
            }
            body {
                margin: 0 !important;
                padding: 0 !important;
                background-color: #f5edda;
            }
            @media only screen and (max-width: 620px) {
                .email-wrap {
                    width: 100% !important;
                }
            }
        </style>
    </head>
    <body style='margin:0;padding:0;background-color:#F5EDDA;'>

        <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='background-color:#F5EDDA;'
        >
            <tr>
                <td align='center' style='padding:32px 16px 48px;'>

                    <table
                        role='presentation'
                        class='email-wrap'
                        width='600'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='max-width:600px;width:100%;'
                    >
                        <tr>
                            <td style='background-color:#080B1A;padding:0 5px 5px 0;'>
                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                >

                                    <tr>
                                        <td style='background-color:#080B1A;padding:14px 28px 0;'>
                                            <table
                                                role='presentation'
                                                width='100%'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                            >
                                                <tr>
                                                    <td>
                                                        <table
                                                            role='presentation'
                                                            cellpadding='0'
                                                            cellspacing='0'
                                                            border='0'
                                                        >
                                                            <tr>
                                                                <td
                                                                    style='vertical-align:middle;padding-right:10px;'
                                                                >
                                                                    <table
                                                                        role='presentation'
                                                                        cellpadding='0'
                                                                        cellspacing='0'
                                                                        border='0'
                                                                    >
                                                                        <tr>
                                                                            <td
                                                                                style='width:5px;height:5px;background-color:#F8CF1E;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:3px;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:5px;height:5px;background-color:#F8CF1E;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:3px;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:5px;height:5px;background-color:#F8CF1E;'
                                                                            ></td>
                                                                        </tr>
                                                                        <tr><td
                                                                                colspan='5'
                                                                                style='height:2px;'
                                                                            ></td></tr>
                                                                        <tr>
                                                                            <td
                                                                                colspan='5'
                                                                                style='height:3px;background-color:#F8CF1E;'
                                                                            ></td>
                                                                        </tr>
                                                                        <tr><td
                                                                                colspan='5'
                                                                                style='height:2px;'
                                                                            ></td></tr>
                                                                        <tr>
                                                                            <td
                                                                                style='width:5px;height:5px;background-color:#F8CF1E;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:3px;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:5px;height:5px;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:3px;'
                                                                            ></td>
                                                                            <td
                                                                                style='width:5px;height:5px;background-color:#F8CF1E;'
                                                                            ></td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                                <td style='vertical-align:middle;'>
                                                                    <span
                                                                        style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:11px;letter-spacing:2px;"
                                                                    >LUMEN COIN</span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td
                                                        align='right'
                                                        style='vertical-align:middle;'
                                                    >
                                                        <span
                                                            style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:8px;letter-spacing:3px;"
                                                        >&#9733; &#9733; &#9733;</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style='height:14px;background-color:#080B1A;'></td>
                                    </tr>
                                    <tr>
                                        <td style='height:4px;background-color:#F5C31A;'></td>
                                    </tr>

                                    <tr>
                                        <td
                                            style='background-color:#FEFAEB;border-left:3px solid #080B1A;border-right:3px solid #080B1A;padding:40px 36px 44px;'
                                        >

                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#F5C31A;font-size:8px;margin:0 0 16px 0;letter-spacing:1px;"
                                            >&#9658; RECOMPENSA DESBLOQUEADA!</p>

                                            <h1
                                                style="font-family:'Press Start 2P',monospace;color:#080B1A;font-size:16px;line-height:1.7;margin:0 0 30px 0;"
                                            >
                                                OL&#193;,
                                                {{studentName}}!<br />
                                                VOC&#202; RECEBEU<br />
                                                <span style='color:#F5C31A;'>{{amount}}
                                                    MOEDAS!</span>
                                            </h1>

                                            <table
                                                role='presentation'
                                                width='100%'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                                style='margin-bottom:36px;'
                                            >
                                                <tr>
                                                    <td
                                                        style='height:2px;background-color:#DDD3B6;'
                                                    ></td>
                                                </tr>
                                                <tr><td style='height:8px;'></td></tr>
                                                <tr>
                                                    <td align='center'>
                                                        <span
                                                            style="font-family:'Press Start 2P',monospace;color:#F5C31A;font-size:10px;letter-spacing:6px;"
                                                        >&#9733; &#9733; &#9733;</span>
                                                    </td>
                                                </tr>
                                                <tr><td style='height:8px;'></td></tr>
                                                <tr>
                                                    <td
                                                        style='height:2px;background-color:#DDD3B6;'
                                                    ></td>
                                                </tr>
                                            </table>

                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:8px;margin:0 0 12px 0;letter-spacing:1px;"
                                            >&#9658; DETALHES DA RECOMPENSA</p>

                                            <table
                                                role='presentation'
                                                width='100%'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                                style='margin-bottom:36px;'
                                            >
                                                <tr>
                                                    <td
                                                        style='background-color:#080B1A;padding:0 3px 3px 0;'
                                                    >
                                                        <table
                                                            role='presentation'
                                                            width='100%'
                                                            cellpadding='0'
                                                            cellspacing='0'
                                                            border='0'
                                                        >
                                                            <tr>
                                                                <td
                                                                    style='background-color:#FEFAEB;border:2px solid #080B1A;padding:20px 24px;'
                                                                >
                                                                    <table
                                                                        role='presentation'
                                                                        width='100%'
                                                                        cellpadding='0'
                                                                        cellspacing='0'
                                                                        border='0'
                                                                    >
                                                                        <tr>
                                                                            <td
                                                                                style='padding-bottom:14px;'
                                                                            >
                                                                                <span
                                                                                    style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;"
                                                                                >ENVIADO POR</span><br
                                                                                />
                                                                                <span
                                                                                    style="font-family:'Press Start 2P',monospace;color:#080B1A;font-size:9px;line-height:2.2;"
                                                                                >{{teacherName}}</span>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td
                                                                                style='padding-bottom:14px;'
                                                                            >
                                                                                <span
                                                                                    style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;"
                                                                                >MOEDAS RECEBIDAS</span><br
                                                                                />
                                                                                <span
                                                                                    style="font-family:'Press Start 2P',monospace;color:#F5C31A;font-size:12px;line-height:2.2;"
                                                                                >&#9678;
                                                                                    {{amount}}</span>
                                                                            </td>
                                                                        </tr>
                                                                        {{#if message}}
                                                                            <tr>
                                                                                <td>
                                                                                    <span
                                                                                        style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;"
                                                                                    >MENSAGEM DO
                                                                                        PROFESSOR</span><br
                                                                                    />
                                                                                    <span
                                                                                        style="font-family:'Press Start 2P',monospace;color:#080B1A;font-size:8px;line-height:2.4;"
                                                                                    >{{message}}</span>
                                                                                </td>
                                                                            </tr>
                                                                        {{/if}}
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>

                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;line-height:2.6;margin:0;text-align:center;"
                                            >
                                                ACESSE A PLATAFORMA PARA VER SEU<br />
                                                SALDO ATUALIZADO E SEUS BENEF&#205;CIOS.
                                            </p>

                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style='height:4px;background-color:#F5C31A;border-left:3px solid #080B1A;border-right:3px solid #080B1A;'
                                        ></td>
                                    </tr>

                                    <tr>
                                        <td
                                            style='background-color:#080B1A;border:3px solid #080B1A;border-top:none;padding:22px 28px;text-align:center;'
                                        >
                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:7px;margin:0 0 10px 0;letter-spacing:1px;"
                                            >
                                                &#169; 2025 LUMEN COIN &#8212; TODOS OS DIREITOS
                                                RESERVADOS
                                            </p>
                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#3A3D5C;font-size:6px;margin:0;line-height:2.4;"
                                            >
                                                VOC&#202; RECEBEU ESTE E-MAIL POR TER RECEBIDO
                                                MOEDAS NA PLATAFORMA.<br />
                                                N&#195;O &#201; NECESS&#193;RIO RESPONDER.
                                            </p>
                                        </td>
                                    </tr>

                                </table>
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
        </table>

    </body>
</html>