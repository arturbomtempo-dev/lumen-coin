<html lang='pt-BR' xmlns='http://www.w3.org/1999/xhtml'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <meta http-equiv='X-UA-Compatible' content='IE=edge' />
        <title>Moedas Enviadas - Lumen Coin</title>
        <link
            href='https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap'
            rel='stylesheet'
            type='text/css'
        />
        <style type='text/css'>
            @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap');
            body,
            table,
            td,
            a {
                -webkit-text-size-adjust: 100%;
                -ms-text-size-adjust: 100%;
            }
            table,
            td {
                mso-table-lspace: 0pt;
                mso-table-rspace: 0pt;
                border-collapse: collapse;
            }
            img {
                border: 0;
                height: auto;
                line-height: 100%;
                outline: none;
                text-decoration: none;
                -ms-interpolation-mode: bicubic;
            }
            body {
                margin: 0 !important;
                padding: 0 !important;
                background-color: #f5edda;
                background-image: repeating-linear-gradient(0deg, transparent, transparent 19px, rgba(8,11,26,0.05) 19px, rgba(8,11,26,0.05) 20px), repeating-linear-gradient(90deg, transparent, transparent 19px, rgba(8,11,26,0.05) 19px, rgba(8,11,26,0.05) 20px);
            }
            @media only screen and (max-width: 620px) {
                .email-wrap {
                    width: 100% !important;
                }
            }
        </style>
    </head>
    <body style='margin:0;padding:0;background-color:#F5EDDA;background-image:repeating-linear-gradient(0deg,transparent,transparent 19px,rgba(8,11,26,0.05) 19px,rgba(8,11,26,0.05) 20px),repeating-linear-gradient(90deg,transparent,transparent 19px,rgba(8,11,26,0.05) 19px,rgba(8,11,26,0.05) 20px);'>

        <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='background-color:#F5EDDA;'
        >
            <tr>
                <td align='center' style='padding:32px 16px 48px;'>

                    <table
                        role='presentation'
                        class='email-wrap'
                        width='600'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='max-width:600px;width:100%;'
                    >
                        <tr>
                            <td style='background-color:#080B1A;padding:0 7px 7px 0;'>
                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                >

                                    <tr>
                                        <td style='background-color:#080B1A;padding:14px 28px 0;'>
                                            <table
                                                role='presentation'
                                                width='100%'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                            >
                                                <tr>
                                                    <td>
                                                        <table
                                                            role='presentation'
                                                            cellpadding='0'
                                                            cellspacing='0'
                                                            border='0'
                                                        >
                                                            <tr>
                                                                <td style='vertical-align:middle;padding-right:12px;'>
                                                                    <table role='presentation' cellpadding='0' cellspacing='0' border='0'>
                                                                        <tr>
                                                                            <td style='width:4px;height:4px;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;'></td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#D4A800;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#D4A800;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#FFDF00;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#D4A800;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#D4A800;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style='width:4px;height:4px;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;background-color:#F8CF1E;'></td>
                                                                            <td style='width:4px;height:4px;'></td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                                <td style='vertical-align:middle;'>
                                                                    <span
                                                                        style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:11px;letter-spacing:2px;"
                                                                    >LUMEN COIN</span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td
                                                        align='right'
                                                        style='vertical-align:middle;'
                                                    >
                                                        <span
                                                            style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:8px;letter-spacing:3px;"
                                                        >&#9733; &#9733; &#9733;</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style='height:14px;background-color:#080B1A;'></td>
                                    </tr>
                                    <tr>
                                        <td style='height:4px;background-color:#177340;'></td>
                                    </tr>

                                    <tr>
                                        <td
                                            style='background-color:#FEFAEB;border-left:3px solid #080B1A;border-right:3px solid #080B1A;padding:40px 36px 44px;'
                                        >

                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#177340;font-size:8px;margin:0 0 16px 0;letter-spacing:1px;"
                                            >&#9658; MISS&#195;O CONCLU&#205;DA!</p>

                                            <h1
                                                style="font-family:'Press Start 2P',monospace;color:#080B1A;font-size:16px;line-height:1.7;margin:0 0 28px 0;"
                                            >
                                                VOC&#202; ENVIOU<br />
                                                <span style='color:#F5C31A;'>{{amount}}
                                                    MOEDAS</span><br />
                                                PARA
                                                {{studentName}}!
                                            </h1>

                                            <table
                                                role='presentation'
                                                width='100%'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                                style='margin-bottom:36px;'
                                            >
                                                <tr>
                                                    <td
                                                        style='height:2px;background-color:#DDD3B6;'
                                                    ></td>
                                                </tr>
                                                <tr><td style='height:8px;'></td></tr>
                                                <tr>
                                                    <td align='center'>
                                                        <span
                                                            style="font-family:'Press Start 2P',monospace;color:#177340;font-size:10px;letter-spacing:6px;"
                                                        >&#10003; &#10003; &#10003;</span>
                                                    </td>
                                                </tr>
                                                <tr><td style='height:8px;'></td></tr>
                                                <tr>
                                                    <td
                                                        style='height:2px;background-color:#DDD3B6;'
                                                    ></td>
                                                </tr>
                                            </table>

                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:8px;margin:0 0 12px 0;letter-spacing:1px;"
                                            >&#9658; DETALHES DA TRANSFER&#202;NCIA</p>

                                            <table
                                                role='presentation'
                                                width='100%'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                                style='margin-bottom:36px;'
                                            >
                                                <tr>
                                                    <td
                                                        style='background-color:#080B1A;padding:0 3px 3px 0;'
                                                    >
                                                        <table
                                                            role='presentation'
                                                            width='100%'
                                                            cellpadding='0'
                                                            cellspacing='0'
                                                            border='0'
                                                        >
                                                            <tr>
                                                                <td
                                                                    style='background-color:#FEFAEB;border:2px solid #080B1A;border-left:4px solid #177340;padding:20px 24px;'
                                                                >
                                                                    <table
                                                                        role='presentation'
                                                                        width='100%'
                                                                        cellpadding='0'
                                                                        cellspacing='0'
                                                                        border='0'
                                                                    >
                                                                        <tr>
                                                                            <td
                                                                                style='padding-bottom:16px;'
                                                                            >
                                                                                <span
                                                                                    style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;"
                                                                                >DESTINAT&#193;RIO</span><br />
                                                                                <span
                                                                                    style="font-family:'VT323',monospace;color:#080B1A;font-size:22px;line-height:1.3;"
                                                                                >{{studentName}}</span>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td
                                                                                style='padding-bottom:16px;'
                                                                            >
                                                                                <span
                                                                                    style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;"
                                                                                >QUANTIDADE</span><br />
                                                                                <span
                                                                                    style="font-family:'VT323',monospace;color:#F5C31A;font-size:28px;line-height:1.3;"
                                                                                >&#9733;
                                                                                    {{amount}} MOEDAS</span>
                                                                            </td>
                                                                        </tr>
                                                                        {{#if message}}
                                                                            <tr>
                                                                                <td>
                                                                                    <span
                                                                                        style="font-family:'Press Start 2P',monospace;color:#2A2D48;font-size:7px;"
                                                                                    >MENSAGEM</span><br />
                                                                                    <span
                                                                                        style="font-family:'VT323',monospace;color:#080B1A;font-size:20px;line-height:1.4;"
                                                                                    >{{message}}</span>
                                                                                </td>
                                                                            </tr>
                                                                        {{/if}}
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>

                                            <p
                                                style="font-family:'VT323',monospace;color:#2A2D48;font-size:18px;line-height:1.5;margin:0;text-align:center;"
                                            >
                                                ACESSE SEU EXTRATO PARA VER<br />
                                                TODAS AS SUAS TRANSFER&#202;NCIAS.
                                            </p>

                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style='height:4px;background-color:#177340;border-left:3px solid #080B1A;border-right:3px solid #080B1A;'
                                        ></td>
                                    </tr>

                                    <tr>
                                        <td
                                            style='background-color:#080B1A;border:3px solid #080B1A;border-top:none;padding:22px 28px;text-align:center;'
                                        >
                                            <p
                                                style="font-family:'Press Start 2P',monospace;color:#F8CF1E;font-size:8px;margin:0 0 12px 0;letter-spacing:1px;"
                                            >
                                                &#169; 2025 LUMEN COIN &#8212; TODOS OS DIREITOS
                                                RESERVADOS
                                            </p>
                                            <p
                                                style="font-family:'VT323',monospace;color:#5A5D7C;font-size:16px;margin:0;line-height:1.5;"
                                            >
                                                VOC&#202; RECEBEU ESTE E-MAIL POR TER REALIZADO UMA
                                                TRANSFER&#202;NCIA.<br />
                                                N&#195;O &#201; NECESS&#193;RIO RESPONDER.
                                            </p>
                                        </td>
                                    </tr>

                                </table>
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
        </table>

    </body>
</html>
